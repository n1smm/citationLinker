# barve - black, white, gray, blue, red , dark_blue
# - samo te, ki so nastete zaenkrat delujejo

# SPECIAL_CASE je lahko tudi lista vec posebnih primerov
# vec primerov mora biti dodanih v tocno taki obliki:
# SPECIAL_CASE="nav. d.", "navedeno zgoraj", "drugi mozni primeri"
# nanasajo se na moznost navajanja istega dela zaporedoma 
# tekst ... (priimek, leto) ....tekst ... (nav. d) ...tekst ... (nav.d)

# BIBLIOGRAPHY_DELIMITER
# ki zaznamuje začetek spiska del/virov
# lahko jih je več, če so različne v različnih dokumentih. v tem primeru:
# najprej vpisati tiste manj pogoste in proti koncu tiste bolj pogoste
# npr. če za večino dokumenotov velja "Literatura" in za manjšino "Viri in literatura"
# se zapiše BIBLIOGRAPHY_DELIMITER="Viri in literatura", "Literatura"

#ANNOT_TYPE=<underline> ali <highlight> - linki podčrtani ali obarvan tekst

# OFFSET - lahko +<number> ali -<number> npr +2 ali -5.
# uporaben samo za multiarticle kjer vpliva na to,
# da prestavi zacetke in konce poglavija naprej ali nazaj za stevilo vpisano v OFFSET

#ARTICLE_BREAKS - samo za multiarticle,
# kjer se specificira kje se zacenjanja in koncajo poglavja,
# ki morajo biti obdelana (poglavje pomeni da ima svojo bibliografijo,
# drugace ni potrebno deliti na poglavja) 
# primer - "1:23", "25:45", "50:110" kjer je prva stevilka zacetek in druga konec poglavja
# konec poglavlja je kjer se zakljuci bibliografija

#SOFT_YEAR - [True/False] preglej tekst z bolj sproscenim filtrom za leta
# vkljucuje razpon letnic npr 1998-2004 ali pa doda se pregled za leto prej in kasneje v primeru napak
#mozno da naredi povezave tudi kjer nebi smele biti

#DEEP_SEARCH - [True/False] za bolj permisivno ujemanje
#mozno da naredi povezave tudi kjer nebi smele biti

#SEARC_EXCLUDE [ "seznam", "seznam1", ] besede, ki jih deep_search nesme vzeti kot smiselne moznosti za povezave

#ALTERNATIVE_BIB [True/False] - ko je najprej letnica potem . (pika) in nato delo
#mozno da naredi povezave tudi kjer nebi smele biti

DEBUG=False
SPECIAL_CASE=
BIBLIOGRAPHY_DELIMITER="REFERENCES", "BIBLIOGRAPHY"
ANNOT_TYPE=underline
COLOR=black
OFFSET=
ARTICLE_BREAKS=
SOFT_YEAR=False
DEEP_SEARCH=False
SEARCH_EXCLUDE=
ALTERNATIVE_BIB=False
LEGACY=True
